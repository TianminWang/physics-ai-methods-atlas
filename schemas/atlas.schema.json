{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianminWang/physics-ai-methods-atlas/blob/main/schemas/atlas.schema.json",
  "title": "Physics AI Methods Atlas data schemas",
  "description": "Backwards compatible Atlas records (2.0.0 and 2.1.0) and unified workflow/method-family schema; semantic validity enforced in scripts/validate.py.",
  "$defs": {
    "area": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "2.0.0",
            "2.1.0"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^area\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "summary_zh": {
          "type": "string",
          "minLength": 5
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "summary"
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "2.0.0",
            "2.1.0"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^method\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "curated"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "core_idea": {
          "type": "string",
          "minLength": 10
        },
        "innovation": {
          "type": "string",
          "minLength": 10
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          },
          "uniqueItems": true
        },
        "background_topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "start_here": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference_id": {
                "type": "string",
                "pattern": "^(paper|book)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "why": {
                "type": "string",
                "minLength": 8
              },
              "focus": {
                "type": "string",
                "minLength": 8
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "exception_reason": {
                "type": "string",
                "minLength": 15
              }
            },
            "required": [
              "reference_id",
              "why",
              "focus"
            ]
          }
        },
        "curation_note": {
          "type": "string",
          "minLength": 10
        },
        "name_zh": {
          "type": "string",
          "minLength": 2
        },
        "summary_zh": {
          "type": "string",
          "minLength": 5
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "status",
        "summary",
        "core_idea"
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "2.0.0",
            "2.1.0"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^problem\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "name_zh": {
          "type": "string",
          "minLength": 2
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "summary",
        "unknowns",
        "observables"
      ]
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "2.0.0",
            "2.1.0"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^paper\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 10
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "venue": {
          "type": "string",
          "minLength": 2
        },
        "publication_status": {
          "enum": [
            "peer_reviewed",
            "preprint",
            "unknown"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "doi": {
              "type": "string",
              "minLength": 1
            },
            "arxiv": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "verification_status": {
          "enum": [
            "verified",
            "provisional"
          ]
        },
        "verification_url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "authors",
        "year",
        "venue",
        "publication_status",
        "url",
        "identifiers",
        "verification_status",
        "verification_url",
        "summary"
      ]
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "2.0.0",
            "2.1.0"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^book\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "authors",
        "year",
        "publisher",
        "url",
        "summary"
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "2.0.0",
            "2.1.0"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^relation\\.[a-z0-9]+(?:-{1,2}[a-z0-9]+)*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^(area|method|paper|book|problem|stage|family|concern)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "target_id": {
          "type": "string",
          "pattern": "^(area|method|paper|book|problem|stage|family|concern)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "belongs_to",
            "subarea_of",
            "specializes",
            "extends",
            "combines",
            "depends_on",
            "contrasts_with",
            "addresses",
            "introduces",
            "analyzes",
            "applies",
            "surveys",
            "compares",
            "covers",
            "uses_method",
            "feeds_into",
            "feeds_back_to",
            "member_of_family",
            "subfamily_of",
            "concern_applies_to"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 8
        },
        "evidence_paper_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^paper\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "significance": {
          "enum": [
            "landmark",
            "representative",
            "supporting"
          ]
        },
        "significance_reason": {
          "type": "string",
          "minLength": 12
        },
        "claim_zh": {
          "type": "string",
          "minLength": 5
        },
        "role": {
          "type": "string",
          "minLength": 8
        },
        "role_zh": {
          "type": "string",
          "minLength": 5
        },
        "innovation_detail": {
          "type": "string",
          "minLength": 8
        },
        "innovation_detail_zh": {
          "type": "string",
          "minLength": 5
        },
        "bottleneck": {
          "type": "string",
          "minLength": 8
        },
        "bottleneck_zh": {
          "type": "string",
          "minLength": 5
        },
        "tradeoff": {
          "type": "string",
          "minLength": 8
        },
        "tradeoff_zh": {
          "type": "string",
          "minLength": 5
        },
        "stage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^stage\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "primary_stage_id": {
          "type": "string",
          "pattern": "^stage\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "evidence_scope": {
          "enum": [
            "conceptual",
            "literature_supported",
            "application_verified",
            "hypothesis"
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "source_id",
        "target_id",
        "type",
        "claim"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "significance": {
                "const": "landmark"
              }
            },
            "required": [
              "significance"
            ]
          },
          "then": {
            "required": [
              "significance_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "extends",
                  "combines"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "innovation_detail",
              "innovation_detail_zh",
              "bottleneck",
              "bottleneck_zh"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "uses_method"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "role",
              "role_zh",
              "claim_zh",
              "evidence_scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "feeds_into",
                  "feeds_back_to",
                  "concern_applies_to"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "claim_zh"
            ]
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^stage\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "name_zh": {
          "type": "string",
          "minLength": 2
        },
        "summary": {
          "type": "string",
          "minLength": 5
        },
        "summary_zh": {
          "type": "string",
          "minLength": 5
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "is_iterative": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "name_zh",
        "summary",
        "summary_zh",
        "order",
        "color",
        "inputs",
        "outputs",
        "is_iterative"
      ]
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^family\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "name_zh": {
          "type": "string",
          "minLength": 2
        },
        "summary": {
          "type": "string",
          "minLength": 5
        },
        "summary_zh": {
          "type": "string",
          "minLength": 5
        },
        "coverage_status": {
          "enum": [
            "populated",
            "planned"
          ]
        },
        "scope_note": {
          "type": "string",
          "minLength": 5
        },
        "scope_note_zh": {
          "type": "string",
          "minLength": 5
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "name_zh",
        "summary",
        "summary_zh",
        "coverage_status",
        "scope_note",
        "scope_note_zh"
      ]
    },
    "concern": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^concern\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "name_zh": {
          "type": "string",
          "minLength": 2
        },
        "summary": {
          "type": "string",
          "minLength": 5
        },
        "summary_zh": {
          "type": "string",
          "minLength": 5
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "name_zh",
        "summary",
        "summary_zh"
      ]
    }
  }
}
