{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianminWang/physics-ai-methods-atlas/blob/main/schemas/atlas.schema.json",
  "title": "Physics AI Methods Atlas data schemas",
  "description": "One JSON document per entity or typed relation. Cross-record constraints are checked by scripts/validate.py.",
  "$defs": {
    "area": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^area\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 10
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "summary"
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^method\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "curated"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "core_idea": {
          "type": "string",
          "minLength": 10
        },
        "innovation": {
          "type": "string",
          "minLength": 10
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          },
          "uniqueItems": true
        },
        "background_topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "start_here": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference_id": {
                "type": "string",
                "pattern": "^(paper|book)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "why": {
                "type": "string",
                "minLength": 8
              },
              "focus": {
                "type": "string",
                "minLength": 8
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "exception_reason": {
                "type": "string",
                "minLength": 15
              }
            },
            "required": [
              "reference_id",
              "why",
              "focus"
            ]
          }
        },
        "curation_note": {
          "type": "string",
          "minLength": 10
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "status",
        "summary",
        "core_idea"
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^problem\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "summary",
        "unknowns",
        "observables"
      ]
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^paper\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 10
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "venue": {
          "type": "string",
          "minLength": 2
        },
        "publication_status": {
          "enum": [
            "peer_reviewed",
            "preprint",
            "unknown"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "doi": {
              "type": "string",
              "minLength": 1
            },
            "arxiv": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "verification_status": {
          "enum": [
            "verified",
            "provisional"
          ]
        },
        "verification_url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "authors",
        "year",
        "venue",
        "publication_status",
        "url",
        "identifiers",
        "verification_status",
        "verification_url",
        "summary"
      ]
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^book\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 10
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "authors",
        "year",
        "publisher",
        "url",
        "summary"
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^relation\\.[a-z0-9]+(?:-{1,2}[a-z0-9]+)*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^(area|method|paper|book|problem)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "target_id": {
          "type": "string",
          "pattern": "^(area|method|paper|book|problem)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "belongs_to",
            "subarea_of",
            "specializes",
            "extends",
            "combines",
            "depends_on",
            "contrasts_with",
            "addresses",
            "introduces",
            "analyzes",
            "applies",
            "surveys",
            "compares",
            "covers"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 8
        },
        "evidence_paper_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^paper\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "significance": {
          "enum": [
            "landmark",
            "representative",
            "supporting"
          ]
        },
        "significance_reason": {
          "type": "string",
          "minLength": 12
        }
      },
      "required": [
        "schema_version",
        "id",
        "source_id",
        "target_id",
        "type",
        "claim"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "significance": {
                "const": "landmark"
              }
            },
            "required": [
              "significance"
            ]
          },
          "then": {
            "required": [
              "significance_reason"
            ]
          }
        }
      ]
    }
  }
}
