{
  "version": "0.7.0",
  "note": "Phases and primary paradigm colors are view semantics, not exclusive scholarly family membership. All source methods/edges remain in data/.",
  "phases": [
    {
      "id": "modeling",
      "number": "Ⅰ",
      "name": {
        "zh": "物理系统建模与正向问题",
        "en": "Physical modeling & forward problems"
      },
      "short": {
        "zh": "建模与正问题",
        "en": "Forward modeling"
      },
      "summary": {
        "zh": "建立控制方程、参数化、初始边界条件、正向求解器与观测模型，定义从物理状态到可观测数据的映射。",
        "en": "Define governing equations, parameterization, boundary conditions, forward solvers and observation operators."
      },
      "color": "#2563EB",
      "stage_ids": [
        "stage.physics-forward",
        "stage.observation"
      ]
    },
    {
      "id": "inference",
      "number": "Ⅱ",
      "name": {
        "zh": "反问题求解与未知信息推断",
        "en": "Inverse problems & inference"
      },
      "short": {
        "zh": "反演与推断",
        "en": "Inverse inference"
      },
      "summary": {
        "zh": "结合有限含噪观测、正向模型与先验，估计未知参数和隐含状态；正则化与可辨识性是关键问题。",
        "en": "Infer unknown parameters and states using partial observations, forward models, priors, and regularization."
      },
      "color": "#7C3AED",
      "stage_ids": [
        "stage.inverse-calibration"
      ]
    },
    {
      "id": "twin",
      "number": "Ⅲ",
      "name": {
        "zh": "个体化预测、干预与闭环更新",
        "en": "Personalized prediction, intervention & updating"
      },
      "short": {
        "zh": "预测与闭环",
        "en": "Prediction & closed loop"
      },
      "summary": {
        "zh": "利用个体化模型预测自然演化与假设干预的结果，支持决策，并通过后续观测持续更新模型。数字孪生与世界模型是相关的系统能力与目标。",
        "en": "Use individualized models for forecasting, counterfactual interventions, planning, and continual model updates."
      },
      "color": "#0D9488",
      "stage_ids": [
        "stage.prediction-uq",
        "stage.intervention-planning",
        "stage.continual-update"
      ]
    }
  ],
